# Server
NODE_ENV=development
PORT=3001

# Database (separate DB so the two services stay independent).
# Host port 3308 because 3306 = native Windows MySQL, 3307 = auth-mysql.
DATABASE_URL="mysql://projects_user:projects_password@localhost:3308/projects_db"

# JWT — MUST be the SAME value as JWT_ACCESS_SECRET in auth-service.
# This service does NOT issue tokens, only verifies them.
JWT_ACCESS_SECRET=replace_with_the_same_secret_as_auth_service
