# =====================================================================
# Copia este archivo a `.env` y rellena con valores reales.
# El archivo `.env` NO debe subirse a git.
#
# IMPORTANTE: estas variables deben coincidir con las del stack ec2-db.
# AUTH_DB_*, PROJECTS_DB_* deben ser EXACTAMENTE las mismas que usaste
# en deploy/ec2-db/.env (los servicios necesitan esas credenciales para
# conectarse a sus bases).
# =====================================================================

# ---------- Credenciales de bases de datos (mismas que ec2-db/.env) ----------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=copia-el-mismo-valor-de-ec2-db/.env

PROJECTS_DB_NAME=projects_db
PROJECTS_DB_USER=projects_user
PROJECTS_DB_PASSWORD=copia-el-mismo-valor-de-ec2-db/.env

# ---------- JWT (genera con: openssl rand -hex 32) ----------
# Minimo 32 caracteres. JWT_ACCESS_SECRET es COMPARTIDO entre auth y projects
# (auth lo firma, projects lo verifica). NUNCA lo expongas. NUNCA lo commitees.
JWT_ACCESS_SECRET=genera-64-chars-hex-aqui
JWT_REFRESH_SECRET=genera-otros-64-chars-hex-aqui

# ---------- Google OAuth (Patron B: idToken nativo) ----------
# Web Client ID del proyecto en Google Cloud Console.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx
# En Patron B el backend NO redirige, pero el validador exige una URL valida.
# Usa la URL publica de tu auth-service o cualquier URL real.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Coma-separados. El Android Client ID que generaste con la huella SHA-1.
# (El Web Client ID ya esta aceptado automaticamente, no lo repitas aqui.)
GOOGLE_MOBILE_CLIENT_IDS=xxxxxxxxxxxx-yyyyyyyy.apps.googleusercontent.com

# ---------- Refresh token via cookie ----------
# Para mobile mantenlo en false (la app maneja el refresh en memoria/storage).
REFRESH_TOKEN_COOKIE=false
