# =====================================================================
# Copia este archivo a `.env` y rellena con valores reales.
#
# Generar passwords fuertes (32 chars urlsafe):
#   openssl rand -base64 24
#
# IMPORTANTE: el archivo `.env` NO debe subirse a git.
# =====================================================================

# Root de MySQL. Solo se usa para tareas administrativas (no para los servicios).
MYSQL_ROOT_PASSWORD=Passw0rd

# Credenciales del usuario que usara el auth-service.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=Passw0rd

# Credenciales del usuario que usara el projects-service.
PROJECTS_DB_NAME=projects_db
PROJECTS_DB_USER=projects_user
PROJECTS_DB_PASSWORD=Passw0rd
